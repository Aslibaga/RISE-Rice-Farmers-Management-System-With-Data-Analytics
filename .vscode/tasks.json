
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start RISE API",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--launch-profile",
                "http",
                "--project",
                "${workspaceFolder}/RISE.API/RISE.API.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}/RISE.API"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "rise-api",
                "pattern": {
                    "regexp": "^\\s*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*$",
                    "endsPattern": "^\\s*Now listening on:"
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}
